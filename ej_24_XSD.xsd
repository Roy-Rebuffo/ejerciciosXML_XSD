<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="libroTipo" mixed="true">
        <xs:sequence>
            <xs:element name="titulo" type="xs:string"></xs:element>
            <xs:element name="autor" type="xs:string"></xs:element>
            <xs:element name="año" type="xs:int"></xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="libros">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="libro" type="libroTipo" maxOccurs="unbounded"></xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>