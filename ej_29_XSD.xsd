<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:complexType name="articuloTipo">
        <xs:sequence>
            <xs:element name="titulo" type="xs:string" />
            <xs:element name="autor" type="xs:string" />
            <xs:element name="fecha" type="xs:date" />
            <xs:element name="palabras_clave" type="xs:string" minOccurs="0" maxOccurs="5" />
        </xs:sequence>
        <xs:attribute name="doi" type="xs:string" use="required" />
    </xs:complexType>

    <xs:element name="articulos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="articulo" type="articuloTipo" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>