<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:complexType name="eventoTipo">
        <xs:sequence>
            <xs:element name="tema" type="xs:string" />
        </xs:sequence>
        <xs:attribute name="tipo" type="xs:string" use="required" />
        <xs:attribute name="fecha" type="xs:date" use="required" />
        <xs:attribute name="lugar" type="xs:string" use="required" />
        <xs:attribute name="capacidad" type="xs:int" use="optional" />
    </xs:complexType>

    <xs:element name="eventos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="evento" type="eventoTipo" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>