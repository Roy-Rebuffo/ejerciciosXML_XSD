<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="usuarios">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="usuario" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nombre"></xs:element>
                            <xs:element name="contrasena">
                            <xs:simpleType>
                            <xs:restriction base="xs:string">
                            <xs:pattern value="[a-zA-Z0-9]"></xs:pattern>
                            <xs:minLength value="6"></xs:minLength>
                            <xs:maxLength value="12"></xs:maxLength>
                            </xs:restriction>
                            </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                        
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>