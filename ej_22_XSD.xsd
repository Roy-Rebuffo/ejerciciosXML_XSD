<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="producto"  maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="sku" type="xs:string"></xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>