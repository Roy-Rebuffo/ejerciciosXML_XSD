<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="direccionBase">
        <xs:restriction base="xs:string">
            <xs:enumeration value="norte"></xs:enumeration>
            <xs:enumeration value="sur"></xs:enumeration>
            <xs:enumeration value="este"></xs:enumeration>
            <xs:enumeration value="oeste"></xs:enumeration>
        </xs:restriction>
    </xs:simpleType>


    <xs:element name="zonas">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="direccionBase">
                    <xs:attribute name="metros"></xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>
</xs:schema>